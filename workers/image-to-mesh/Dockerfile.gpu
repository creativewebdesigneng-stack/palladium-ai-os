FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends git build-essential \
    && rm -rf /var/lib/apt/lists/*

# CPU PyTorch is enough to boot TripoSR. A CUDA host should replace this wheel
# with the matching CUDA build from https://pytorch.org before production use.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir trimesh rembg pillow

RUN git clone --depth 1 https://github.com/VAST-AI-Research/TripoSR /opt/TripoSR \
    && pip install --no-cache-dir -r /opt/TripoSR/requirements.txt || true

WORKDIR /app
COPY server.py run_triposr.py ./
ENV TRIPOSR_REPO=/opt/TripoSR
ENV TRIPOSR_PYTHON=/usr/local/bin/python
ENV PYTHONUNBUFFERED=1
ENV MESH_BIND=0.0.0.0
ENV PORT=8080
EXPOSE 8080
CMD ["python", "server.py"]
