# Supabase client configuration (publishable values only)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Server-only secrets belong in your deployment secret manager / local .env.
# Never commit service-role keys, OAuth client secrets, encryption keys,
# provider API keys, Stripe secrets, webhook secrets or browser worker tokens.
#
# AI model providers
# ------------------
# The agent runtime supports Lovable AI Gateway, OpenAI, Anthropic, and any
# OpenAI-compatible endpoint. Provider credentials are SERVER-ONLY. Never use
# VITE_ prefixes for model API keys.
#
# Recommended production provider for PalladiumAI agents:
# OPENAI_API_KEY="replace-in-your-secret-manager"
# ASSISTANT_PROVIDER="openai"
# ASSISTANT_MODEL="gpt-5-mini"
#
# Lovable AI Gateway (used automatically when selected/configured):
# LOVABLE_API_KEY="replace-in-your-secret-manager"
#
# Optional Anthropic provider:
# ANTHROPIC_API_KEY="replace-in-your-secret-manager"
#
# Optional OpenAI-compatible/local provider:
# OPENAI_COMPATIBLE_BASE_URL="https://your-compatible-provider.example/v1"
# OPENAI_COMPATIBLE_API_KEY="replace-in-your-secret-manager"
#
# Integration security foundation
# -------------------------------
# Public origin of the deployed PalladiumAI app, without a trailing slash.
# APP_ORIGIN="https://your-palladium-domain.example"
#
# Generate independent random values of at least 32 characters. These sign
# OAuth/GitHub connection state and encrypt third-party OAuth credentials.
# INTEGRATION_STATE_SECRET="replace-in-your-secret-manager"
# INTEGRATION_TOKEN_KEY="replace-in-your-secret-manager"
#
# OAuth integration providers
# ---------------------------
# Register a server-side OAuth application with each provider you want users to
# connect. For every provider below, configure this exact redirect/callback URL:
#   ${APP_ORIGIN}/api/public/integrations/callback
# Keep all client secrets SERVER-ONLY and never prefix them with VITE_.
#
# GOOGLE_INTEGRATION_CLIENT_ID="replace-in-your-secret-manager"
# GOOGLE_INTEGRATION_CLIENT_SECRET="replace-in-your-secret-manager"
# MICROSOFT_INTEGRATION_CLIENT_ID="replace-in-your-secret-manager"
# MICROSOFT_INTEGRATION_CLIENT_SECRET="replace-in-your-secret-manager"
# SLACK_INTEGRATION_CLIENT_ID="replace-in-your-secret-manager"
# SLACK_INTEGRATION_CLIENT_SECRET="replace-in-your-secret-manager"
# DISCORD_INTEGRATION_CLIENT_ID="replace-in-your-secret-manager"
# DISCORD_INTEGRATION_CLIENT_SECRET="replace-in-your-secret-manager"
# HUBSPOT_INTEGRATION_CLIENT_ID="replace-in-your-secret-manager"
# HUBSPOT_INTEGRATION_CLIENT_SECRET="replace-in-your-secret-manager"
# SALESFORCE_INTEGRATION_CLIENT_ID="replace-in-your-secret-manager"
# SALESFORCE_INTEGRATION_CLIENT_SECRET="replace-in-your-secret-manager"
# NOTION_INTEGRATION_CLIENT_ID="replace-in-your-secret-manager"
# NOTION_INTEGRATION_CLIENT_SECRET="replace-in-your-secret-manager"
# ASANA_INTEGRATION_CLIENT_ID="replace-in-your-secret-manager"
# ASANA_INTEGRATION_CLIENT_SECRET="replace-in-your-secret-manager"
# LINEAR_INTEGRATION_CLIENT_ID="replace-in-your-secret-manager"
# LINEAR_INTEGRATION_CLIENT_SECRET="replace-in-your-secret-manager"
#
# GitHub App — read-only repository integration
# ---------------------------------------------
# Create a GitHub App for PalladiumAI and keep every value below SERVER-ONLY.
# Do not prefix these with VITE_. The private key may be stored as the PEM text
# itself or with literal \n escapes; PalladiumAI normalises either format.
# GITHUB_APP_ID="123456"
# GITHUB_APP_SLUG="your-palladium-github-app-slug"
# GITHUB_APP_CLIENT_ID="Iv1.xxxxxxxxxxxxxxxx"
# GITHUB_APP_CLIENT_SECRET="replace-in-your-secret-manager"
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional Nango integration pilot. Keep all values server-side. Configure
# ${APP_ORIGIN}/api/public/integrations/nango-webhook as the environment webhook
# URL in Nango. The webhook signing key is distinct from the scoped API key.
# API scopes: environment:connect_sessions:write, environment:connections:read,
# environment:connections:delete, and environment:proxy.
# NANGO_SECRET_KEY=nango_secret_or_scoped_api_key
# NANGO_GITHUB_INTEGRATION_ID=github-getting-started
# NANGO_WEBHOOK_SIGNING_KEY=replace-with-nango-environment-signing-key
#
# GitHub App repository permissions:
#   Metadata: Read-only
#   Contents: Read-only
# Configure the GitHub App to request user authorization during installation.
# Set its callback URL to:
#   ${APP_ORIGIN}/api/public/integrations/github-callback
# Users can then select only the repositories they want PalladiumAI to read.
# PalladiumAI does not persist GitHub user tokens or installation access tokens;
# it stores the verified installation id and mints read-only installation tokens
# server-side on demand.
#
# Durable background workers
# --------------------------
# The deployment must expose these two server-side secrets. Generate separate,
# random values of at least 32 characters. The internal endpoints reject short
# or missing secrets rather than falling back to an insecure default.
# WEBHOOK_RETRY_CRON_SECRET="replace-in-your-secret-manager"
# WORKFLOW_RUNNER_CRON_SECRET="replace-in-your-secret-manager"
#
# Production queue draining has one authoritative scheduler: Supabase pg_cron
# + pg_net. It POSTs every five minutes to:
#   /api/internal/workflow-runs?limit=4
#   /api/internal/webhook-retries?limit=50
# Bearer tokens are loaded from Supabase Vault. Do not add a second GitHub
# Actions scheduler unless the pg_cron jobs are intentionally retired first.
# See .github/RUNTIME_WORKERS.md for the operational contract.
#
# Browser automation
# ------------------
# Production browser actions require a real provider. The first configured
# provider is selected unless BROWSER_AGENT_PROVIDER names one explicitly.
# BROWSER_AGENT_PROVIDER="playwright"
# PLAYWRIGHT_BROWSER_ENDPOINT="https://your-browser-worker.example"
# PLAYWRIGHT_BROWSER_TOKEN="replace-in-your-secret-manager"
#
# Google Shopping Live Explorer (recommended product discovery source).
# Keep this SERVER-ONLY. When configured, shopping searches use Google Shopping
# results first and Playwright remains available as the browser/fallback layer.
# SERPAPI_API_KEY="replace-in-your-secret-manager"
#
# Alternative Browserbase runner:
# BROWSERBASE_API_KEY="replace-in-your-secret-manager"
# BROWSERBASE_PROJECT_ID="replace-in-your-secret-manager"
# BROWSERBASE_RUNNER_ENDPOINT="https://your-browserbase-runner.example"
#
# Never enable BROWSER_AGENT_ALLOW_SIMULATION in production. When no production
# provider is configured, browser/shopping actions are refused rather than faked.
#
# Payments
# --------
# Billing mode is selected SERVER-SIDE. Browser requests cannot choose which
# Stripe account/credentials are used. Existing deployments default to sandbox.
# Set this to live only after Stripe go-live, live lookup-key prices, and the
# live webhook endpoint/secret have all been verified.
# PAYMENTS_ENVIRONMENT="sandbox" # sandbox | live
# STRIPE_SANDBOX_API_KEY="replace-in-your-secret-manager"
# PAYMENTS_SANDBOX_WEBHOOK_SECRET="replace-in-your-secret-manager"
# STRIPE_LIVE_API_KEY="replace-in-your-secret-manager"
# PAYMENTS_LIVE_WEBHOOK_SECRET="replace-in-your-secret-manager"
# VITE_PAYMENTS_CLIENT_TOKEN="pk_test_or_pk_live_publishable_key"
