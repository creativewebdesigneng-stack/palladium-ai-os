# Supabase client configuration (publishable values only)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Server-only secrets belong in your deployment secret manager / local .env.
# Never commit service-role keys, OAuth client secrets, encryption keys,
# provider API keys, Stripe secrets, webhook secrets or browser worker tokens.
#
# Integration security foundation
# -------------------------------
# Public origin of the deployed PalladiumAI app, without a trailing slash.
# APP_ORIGIN="https://your-palladium-domain.example"
#
# Generate independent random values of at least 32 characters. These sign
# OAuth/GitHub connection state and encrypt third-party OAuth credentials.
# INTEGRATION_STATE_SECRET="replace-in-your-secret-manager"
# INTEGRATION_TOKEN_KEY="replace-in-your-secret-manager"
#
# GitHub App — read-only repository integration
# ---------------------------------------------
# Create a GitHub App for PalladiumAI and keep every value below SERVER-ONLY.
# Do not prefix these with VITE_. The private key may be stored as the PEM text
# itself or with literal \n escapes; PalladiumAI normalises either format.
# GITHUB_APP_ID="123456"
# GITHUB_APP_SLUG="your-palladium-github-app-slug"
# GITHUB_APP_CLIENT_ID="Iv1.xxxxxxxxxxxxxxxx"
# GITHUB_APP_CLIENT_SECRET="replace-in-your-secret-manager"
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#
# GitHub App repository permissions:
#   Metadata: Read-only
#   Contents: Read-only
# Configure the GitHub App to request user authorization during installation.
# Set its callback URL to:
#   ${APP_ORIGIN}/api/public/integrations/github-callback
# Users can then select only the repositories they want PalladiumAI to read.
# PalladiumAI does not persist GitHub user tokens or installation access tokens;
# it stores the verified installation id and mints read-only installation tokens
# server-side on demand.
#
# Durable background workers
# --------------------------
# The deployment must expose these two server-side secrets. Generate separate,
# random values of at least 32 characters. The internal endpoints reject short
# or missing secrets rather than falling back to an insecure default.
# WEBHOOK_RETRY_CRON_SECRET="replace-in-your-secret-manager"
# WORKFLOW_RUNNER_CRON_SECRET="replace-in-your-secret-manager"
#
# .github/workflows/runtime-workers.yml can drain both durable queues every
# five minutes. Configure these GitHub Actions repository secrets:
#   PALLADIUM_BASE_URL             = https://your-deployed-app.example
#   WEBHOOK_RETRY_CRON_SECRET      = same value used by the deployed app
#   WORKFLOW_RUNNER_CRON_SECRET    = same value used by the deployed app
#
# The scheduler POSTs only to protected internal worker endpoints. It cannot
# choose a workflow, user, agent, webhook destination or arbitrary payload.
