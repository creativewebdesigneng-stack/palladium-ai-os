{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blackstar",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "workers_dev": false,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ]
}
