# Blackstar Astra-class serving bundle
# Copy to .env on the GPU host. Never commit the real values.

# Exact public model identity Blackstar will certify and route to.
BLACKSTAR_SERVED_MODEL_NAME=blackstar-astra-v0.1

# Open-weight checkpoint or local model path loaded by vLLM.
# Example only: choose the model after Model Arena evaluation.
BLACKSTAR_MODEL_REPOSITORY=replace-with-your-open-weight-model

# Long random secret shared only with the Blackstar web deployment.
BLACKSTAR_ASTRA_API_KEY=replace-with-a-random-secret-at-least-32-characters

# Optional Hugging Face token for gated/private weights. Leave empty for public weights.
HF_TOKEN=

# Start conservatively; raise only after validating the selected checkpoint and GPU memory.
BLACKSTAR_MAX_MODEL_LEN=131072
BLACKSTAR_TENSOR_PARALLEL_SIZE=1
BLACKSTAR_GPU_MEMORY_UTILIZATION=0.90

# External reverse-proxy listen port on the GPU host.
BLACKSTAR_PROXY_PORT=8080
