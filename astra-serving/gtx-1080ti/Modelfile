# Optional 11 GB context cap for Qwen3 8B Q4_K_M.
# From the repository root, after `ollama pull qwen3:8b-q4_K_M`:
#   ollama create blackstar-qwen3-8b-q4 -f astra-serving/gtx-1080ti/Modelfile
# Then set BLACKSTAR_NATIVE_MODEL=blackstar-qwen3-8b-q4
# The default tag qwen3:8b-q4_K_M also works. Set OLLAMA_CONTEXT_LENGTH=8192
# before starting Ollama if you do not create this alias.
FROM qwen3:8b-q4_K_M
PARAMETER num_ctx 8192
PARAMETER temperature 0.2
